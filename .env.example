# Public (browser-visible) configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server-only configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_PROJECT_ID=your-project-id

# Deployment secrets — set these in project settings, NOT in a committed file.
# VAULT_PASSPHRASE=          master passphrase of the encrypted secret vault
# VAULT_SEED_JSON=           encrypted vault bundle (admin panel → الخزنة والأسرار)
# SUPABASE_SERVICE_ROLE_KEY= privileged server key
